{
  "name": "sovendus-integration-settings-ui",
  "version": "4.3.27",
  "license": "GPL-3.0-only",
  "private": false,
  "description": "Sovendus Integration Plugin Settings UI - React/tailwind based UI to configure Sovendus Integration Plugins",
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "dist/logos/**/*",
    "src/**/*"
  ],
  "type": "module",
  "types": "./dist/package/index.d.ts",
  "main": "./dist/package/index.mjs",
  "module": "./dist/package/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.mjs",
      "require": "./dist/package/index.cjs"
    },
    "./style-less": {
      "types": "./dist/package-style-less/index.d.ts",
      "import": "./dist/package-style-less/index.mjs",
      "require": "./dist/package-style-less/index.cjs"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.mjs",
      "require": "./dist/demo/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.cjs"
    },
    "./demo-style-less": {
      "types": "./dist/demo-style-less/index.d.ts",
      "import": "./dist/demo-style-less/index.mjs",
      "require": "./dist/demo-style-less/index.cjs"
    },
    "./raw-style.css": {
      "import": "./src/app.css",
      "require": "./src/app.css"
    },
    "./style.css": {
      "import": "./dist/package-style-less/sovendus-integration-settings-ui.css",
      "require": "./dist/package-style-less/sovendus-integration-settings-ui.css"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "sovendus-builder build",
    "lint": "eslint --fix",
    "pub": "sovendus-release-tool"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovendus-GmbH/sovendus-integration-settings-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Sovendus-GmbH/sovendus-integration-settings-ui/issues"
  },
  "homepage": "https://github.com/Sovendus-GmbH/sovendus-integration-settings-ui#readme",
  "keywords": [
    "sovendus",
    "integration",
    "types",
    "typescript"
  ],
  "author": "Kevin Barth <techsupport@sovendus.com>",
  "contributors": [
    {
      "name": "Kevin Barth - Sovendus GmbH",
      "email": "techsupport@sovendus.com"
    }
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "sovendus-integration-types": "3.9.5"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.2.1",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.9",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/vite": "4.1.11",
    "@types/eslint": "9.6.1",
    "@types/node": "24.2.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.1.4",
    "framer-motion": "12.23.12",
    "lucide-react": "0.536.0",
    "next": "14",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-eslint": "16.4.2",
    "prettier-plugin-sort-json": "4.1.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "7.62.0",
    "sovendus-builder": "1.5.2",
    "sovendus-release-tool": "1.5.3",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.11",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.0.6",
    "vite-plugin-css-injected-by-js": "3.5.2"
  },
  "updateIgnoreDependencies": [
    "@types/react",
    "@types/react-dom",
    "react",
    "react-dom",
    "next"
  ]
}